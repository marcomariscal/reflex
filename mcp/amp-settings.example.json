{
  "amp.mcpServers": {
    "reflex": {
      "command": "node",
      "args": ["/path/to/reflex/mcp/src/server.ts"],
      "env": {
        "REFLEX_SCORER_URL": "https://<project-ref>.supabase.co/functions/v1/reflex-score",
        "REFLEX_AGENT_KEY": "<the key whose hash is on the agent row>",
        "REFLEX_HOLD_WAIT_S": "120"
      }
    }
  }
}
